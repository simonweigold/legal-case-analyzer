{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "allowJs": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
  "types": ["node", "react", "react-dom", "vite/client"],
    "allowSyntheticDefaultImports": true,
    "noEmit": true
  },
  "include": ["src", "vite.config.ts"],
  "exclude": [
    "dist",
    "node_modules",
    "tailwind.config.js",
  "postcss.config.js",
  "src/hooks/useTheme_old.ts"
  ,"src/index.tsx"
  ]
}
